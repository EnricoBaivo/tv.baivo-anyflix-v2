# Server settings
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Logging
LOG_LEVEL=DEBUG
DEBUG_EXTRACTORS=true
DEBUG_PROVIDERS=true

# Caching - disabled (set to true and ensure Redis is running to enable)
